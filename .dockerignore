# Build context is tiny by design (karakana package + metadata only).
# Keep junk out anyway so the context stays clean as the repo grows.
.git/
.github/
.venv/
venv/
dist/
build/
*.egg-info/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.DS_Store
**/*.log
**/*.sqlite
**/*.sqlite-*
**/*.db
